# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore — nie commituj kluczy.
# Sekcje odpowiadają modułom; każdy moduł czyta tylko swoje zmienne.

# --- bajka/app.py: skąd bierzemy AI i gdzie gra odcinek ---
# local = wszystko na tym komputerze (Foundry Local + głos Windows), bez kluczy i bez internetu po pierwszym
#         pobraniu modeli; azure = usługi Azure (sekcje z kluczami niżej). Flaga --backend nadpisuje.
BAJKA_BACKEND=local
# web = odcinek w przeglądarce z oknami wyboru (pilot, dotyk, głos); vlc = pełny ekran VLC, odpowiedzi tylko głosem.
BAJKA_PLAYER=web
# język dziecka i bohatera (STT i TTS w obu trybach)
BAJKA_LANGUAGE=pl-PL

# --- bajka/foundry.py: Foundry Local (wspólne dla local_stt i local_intent) ---
# auto = Foundry Local sam wybiera wariant pod sprzęt (na Copilot+ PC: NPU); można wymusić NPU, GPU albo CPU.
FOUNDRY_DEVICE=auto

# --- bajka/local_intent.py: lokalny model językowy (alias z: python -m bajka.foundry) ---
FOUNDRY_CHAT_MODEL=phi-4-mini
FOUNDRY_CHAT_TEMPERATURE=0.3

# --- bajka/local_stt.py: lokalny Whisper + wykrywanie wypowiedzi ---
# whisper-tiny jest najszybszy; większy wariant (jeśli jest w python -m bajka.foundry) lepiej rozumie polski.
FOUNDRY_STT_MODEL=whisper-tiny
BAJKA_VAD_THRESHOLD=500
BAJKA_MAX_UTTERANCE_MS=12000

# --- bajka/local_tts.py: głos z syntezatora Windows (lista głosów: python -m bajka.local_tts --list) ---
BAJKA_WINDOWS_VOICE=Paulina
BAJKA_WINDOWS_VOICE_RATE=0.9
BAJKA_WINDOWS_VOICE_PITCH=1.0

# --- Wspólne dla bajka/stt.py i bajka/tts.py: Azure AI Speech (tylko BAJKA_BACKEND=azure) ---
# portal.azure.com → zasób "Speech" → "Klucze i punkt końcowy"
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# --- bajka/stt.py i bajka/local_stt.py: rozpoznawanie mowy (opcjonalne, to są wartości domyślne) ---
BAJKA_INITIAL_SILENCE_MS=6000
BAJKA_END_SILENCE_MS=1200

# --- bajka/tts.py: głos bohatera (opcjonalne, to są wartości domyślne) ---
BAJKA_VOICE=pl-PL-MarekNeural
BAJKA_VOICE_RATE=-10%

# --- bajka/intent.py: Azure OpenAI (tylko BAJKA_BACKEND=azure) ---
# zasób Azure OpenAI → "Klucze i punkt końcowy"; DEPLOYMENT to nazwa wdrożenia modelu, nie nazwa modelu
AZURE_OPENAI_ENDPOINT=https://twoj-zasob.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- bajka/app.py: przebieg odcinka (opcjonalne) ---
# ile razy postać dopyta, zanim wybierze sama
BAJKA_MAX_REPROMPTS=2
# ile sekund trwa okno wyboru (3–60); scena może mieć własne `timeout`. Dzieci 4–7 lat: 12 s i więcej.
BAJKA_CHOICE_SECONDS=12

# --- bajka/web_player.py: odtwarzacz w przeglądarce (--player web) ---
# 127.0.0.1 = tylko ten komputer (przeglądarka da wtedy mikrofon bez HTTPS)
BAJKA_WEB_HOST=127.0.0.1
BAJKA_WEB_PORT=8080
# 1 = sam otwórz przeglądarkę ze stroną odcinka (albo flaga --no-browser, żeby nie otwierać)
BAJKA_WEB_OPEN=1
# najdłuższe nagranie odpowiedzi głosem i zapas na jego rozpoznanie po końcu odliczania
BAJKA_WEB_ANSWER_SECONDS=6
BAJKA_WEB_GRACE_SECONDS=4

# --- bajka/mobile.py: drugi ekran — telefony domowników jako pilot z mikrofonem ---
# 1 = włączony (albo flaga --mobile). Telefony i komputer muszą być w tej samej sieci Wi-Fi.
BAJKA_MOBILE=0
BAJKA_MOBILE_PORT=8443
# Mikrofon w przeglądarce telefonu działa tylko przez HTTPS; pusty CERT/KEY = certyfikat samopodpisany w ~/.bajka
BAJKA_MOBILE_HTTPS=1
BAJKA_MOBILE_CERT=
BAJKA_MOBILE_KEY=
BAJKA_MOBILE_ROUND_SECONDS=8
BAJKA_MOBILE_RESOLVE_SECONDS=4
BAJKA_MOBILE_ANSWER_SECONDS=6
BAJKA_MOBILE_WORKERS=2

# --- bajka/pulse.py: tętno widza (pomysł na przyszłość: zegarek); dziś symulator sterowany z panelu (--panel) ---
BAJKA_PULSE_VIEWERS=1
BAJKA_PULSE_START_BPM=90
# Progi względem tętna tuż po pierwszej scenie: pobudzenie (tętno ≥ ×1,15) albo znużenie (≤ ×0,97).
BAJKA_PULSE_EXCITED=1.15
BAJKA_PULSE_BORED=0.97

# --- bajka/panel.py: panel podglądu w przeglądarce (flaga --panel albo BAJKA_PANEL=1) ---
BAJKA_PANEL=0
# 127.0.0.1 = tylko ten komputer; 0.0.0.0 = także tablet w tej samej sieci Wi-Fi
BAJKA_PANEL_HOST=127.0.0.1
BAJKA_PANEL_PORT=8090
